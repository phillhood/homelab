tunnel: {{ pault_tunnel_id }}
credentials-file: /etc/cloudflared/credentials.json
no-autoupdate: true
ingress:
{% if pault_api_image %}
  - hostname: {{ pault_public_host }}
    path: ^/(api|healthz)
    service: http://pault-api:8080
{% endif %}
{% if pault_web_image %}
  - hostname: {{ pault_public_host }}
    service: http://pault-web:8080
{% endif %}
  - hostname: {{ pault_media_host }}
    service: http://minio:9000
  - service: http_status:404
